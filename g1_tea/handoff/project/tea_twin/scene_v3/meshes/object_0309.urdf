<?xml version="1.0" encoding="utf-8"?>
<!-- Nova movable environment body for the bundled PyBullet launcher. SI metres/kg/radians. Loaded at its body origin; hinge/slider bodies use a fixed world_anchor base with one passive joint. Inertia is about COM. -->
<robot name="nova_environment_object_0309">
  <link name="body">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.000587475" iyy="0.000587475" izz="0.00030375" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="object_0309.obj" />
      </geometry>
      <material name="surface">
        <color rgba="0.9 0.88 0.82 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="object_0309_collision_00.obj" />
      </geometry>
    </collision>
  </link>
</robot>
