  <link name="body">
    <inertial>
      <origin xyz="0 0 0.0175" rpy="0 0 0" />
      <mass value="0.06" />
      <inertia ixx="4.90605556e-05" iyy="9.8605e-05" izz="0.000135415556" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="object_0308.obj" />
      </geometry>
      <material name="surface">
        <color rgba="0.78 0.2 0.25 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="object_0308_collision_00.obj" />
      </geometry>
    </collision>
  </link>
</robot>
