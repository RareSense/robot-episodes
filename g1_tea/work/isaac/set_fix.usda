#usda 1.0
(
    doc = """Build work/isaac/set_fix.usda: a visual-only override layer for the tea corner.
- mug rack object_0310: matte black stepped stand built on the twin's own collision boards (same sizes and
  places), rounded step corners and chamfered edges, cream cloth liners on the three tiers (as in the video);
- mugs object_0311..0321: glossy black lathed body with real inner wall and floor, cream unglazed rim and
  foot ring, swept ear handle inside the twin's handle collision hull;
- sachet tray object_0299 and contents object_0300..0308: matte black box/dividers on the collision boards,
  FRESH / USED tabs, open square plastic tubs, printed sachets, sticks, envelopes, loose tea bags, pink packs
  (stacked so every piece rests on another: the twin's stacks floated 0.5-6.5 mm apart).
The twin's original visual mesh of each object is made invisible; new meshes live under <object>/set_visual in
the object's own frame, so the render keeps posing them from the physics. No collision prim is touched."""
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    over "Looks"
    {
        def Material "set_rack_black_wood"
        {
            token outputs:surface.connect = </World/Looks/set_rack_black_wood/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.12
                float inputs:clearcoatRoughness = 0.35
                color3f inputs:diffuseColor = (0.016, 0.016, 0.018)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                color3f inputs:specularColor = (0.5, 0.5, 0.5)
                token outputs:surface
            }
        }

        def Material "set_cloth_cream"
        {
            token outputs:surface.connect = </World/Looks/set_cloth_cream/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.05
                color3f inputs:diffuseColor.connect = </World/Looks/set_cloth_cream/tex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 1
                color3f inputs:specularColor = (0.15, 0.15, 0.15)
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./set_tex/tier_cloth.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/set_cloth_cream/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

