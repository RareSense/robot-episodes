#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    over "Looks"
    {
        def Material "room_floor"
        {
            token outputs:surface.connect = </World/Looks/room_floor/S.outputs:surface>

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color3f inputs:diffuseColor.connect = </World/Looks/room_floor/diff.outputs:rgb>
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </World/Looks/room_floor/nor.outputs:rgb>
                float inputs:roughness.connect = </World/Looks/room_floor/rough.outputs:r>
                token outputs:surface
            }

            def Shader "diff"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./pbr/room_floor/floor_tiles_diff.png@
                float4 inputs:scale = (0.74, 0.46, 0.28, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/room_floor/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "rough"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./pbr/room_floor/room_floor_rough.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/room_floor/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "nor"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @./pbr/room_floor/floor_tiles_nor_gl.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/room_floor/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

