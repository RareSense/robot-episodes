#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    def "Looks"
    {
        def Material "floor"
        {
            token outputs:surface.connect = </World/Looks/floor/S.outputs:surface>

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/floor/diff.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </World/Looks/floor/rough.outputs:r>
                token outputs:surface
            }

            def Shader "diff"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @pbr/floor/floor_tiles_06_diff_4k.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/floor/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "rough"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @pbr/floor/floor_tiles_06_rough_4k.jpg@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/floor/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }
        }

        def Material "oak"
        {
            token outputs:surface.connect = </World/Looks/oak/S.outputs:surface>

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/oak/diff.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </World/Looks/oak/rough.outputs:r>
                token outputs:surface
            }

            def Shader "diff"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @pbr/oak/oak_veneer_03_diff_4k.jpg@
                float4 inputs:scale = (0.95, 0.6, 0.3, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/oak/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "rough"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @pbr/oak/oak_veneer_03_rough_4k.jpg@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/oak/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }
        }

        def Material "wall"
        {
            token outputs:surface.connect = </World/Looks/wall/S.outputs:surface>

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/wall/diff.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </World/Looks/wall/rough.outputs:r>
                token outputs:surface
            }

            def Shader "diff"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @pbr/wall/beige_wall_001_diff_4k.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/wall/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "rough"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @pbr/wall/beige_wall_001_rough_4k.jpg@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/wall/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }
        }

        def Material "cabinet_dark"
        {
            token outputs:surface.connect = </World/Looks/cabinet_dark/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.3
                color3f inputs:diffuseColor = (0.045, 0.045, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
