            token outputs:surface.connect = </World/Looks/brushed_steel/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color3f inputs:diffuseColor = (0.62, 0.63, 0.65)
                float inputs:metallic = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "led_diffuser"
        {
            token outputs:surface.connect = </World/Looks/led_diffuser/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                color3f inputs:emissiveColor = (6, 5.8, 5.4)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

