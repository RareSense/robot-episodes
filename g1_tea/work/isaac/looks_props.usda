#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    over "Looks"
    {
        def Material "props_mug_glaze"
        {
            token outputs:surface.connect = </World/Looks/props_mug_glaze/S.outputs:surface>

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 1
                color3f inputs:diffuseColor.connect = </World/Looks/props_mug_glaze/diff.outputs:rgb>
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </World/Looks/props_mug_glaze/nor.outputs:rgb>
                float inputs:roughness.connect = </World/Looks/props_mug_glaze/rough.outputs:r>
                token outputs:surface
            }

            def Shader "diff"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./pbr/props_mug_glaze/props_mug_glaze_diff.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/props_mug_glaze/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "rough"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./pbr/props_mug_glaze/props_mug_glaze_rough.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/props_mug_glaze/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "nor"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @./pbr/props_mug_glaze/props_mug_glaze_nor_gl.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/props_mug_glaze/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

