#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    over "Looks"
    {
        def Material "exterior_soil_3d3326"
        {
            token outputs:surface.connect = </World/Looks/exterior_soil_3d3326/S.outputs:surface>

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color3f inputs:diffuseColor.connect = </World/Looks/exterior_soil_3d3326/diff.outputs:rgb>
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </World/Looks/exterior_soil_3d3326/nor.outputs:rgb>
                float inputs:occlusion.connect = </World/Looks/exterior_soil_3d3326/ao.outputs:r>
                float inputs:roughness.connect = </World/Looks/exterior_soil_3d3326/rough.outputs:r>
                token outputs:surface
            }

            def Shader "diff"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./pbr/exterior_soil/dry_ground_01_diff_2k.jpg@
                float4 inputs:scale = (1.0402106, 1.0352008, 1.0510758, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/exterior_soil_3d3326/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "rough"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./pbr/exterior_soil/dry_ground_01_rough_2k.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/exterior_soil_3d3326/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "nor"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @./pbr/exterior_soil/dry_ground_01_nor_gl_2k.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/exterior_soil_3d3326/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "ao"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./pbr/exterior_soil/dry_ground_01_ao_2k.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/exterior_soil_3d3326/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }
        }

