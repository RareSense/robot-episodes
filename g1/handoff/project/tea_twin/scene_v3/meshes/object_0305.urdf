<?xml version="1.0" encoding="utf-8"?>
<!-- Nova movable environment body for the bundled PyBullet launcher. SI metres/kg/radians. Loaded at its body origin; hinge/slider bodies use a fixed world_anchor base with one passive joint. Inertia is about COM. -->
<robot name="nova_environment_object_0305">
  <link name="body">
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0" />
      <mass value="0.06" />
      <inertia ixx="4.56022222e-05" iyy="9.698e-05" izz="0.000133582222" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="object_0305.obj" />
      </geometry>
      <material name="surface">
        <color rgba="0.91 0.88 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="object_0305_collision_00.obj" />
      </geometry>
    </collision>
  </link>
</robot>
